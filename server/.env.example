PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string (required for production)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/knwshare?retryWrites=true&w=majority

# JWT — use a long random string in production
JWT_SECRET=replace_with_a_very_long_random_secret_string
JWT_EXPIRES_IN=30d

# AI provider (Gemini Backend Service)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
